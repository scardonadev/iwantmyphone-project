{
  "name": "iwantmyphone-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de la app nativa iwantmyphone (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "db:setup": "node --env-file-if-exists=.env db/setup.ts",
    "db:reset": "node --env-file-if-exists=.env db/setup.ts --force",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1"
  }
}
