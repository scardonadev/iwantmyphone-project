# Copiar a .env (ignorado por git) y ajustar.

# ---------------------------------------------------------------- Servidor
PORT=4000
# URL pública de la API, sin barra final. La usan los correos y ePayco
# (url de confirmación y de respuesta), así que en producción tiene que ser
# alcanzable desde internet.
PUBLIC_URL=http://localhost:4000
# Zona horaria de los reportes: "hoy", "ayer" y "esta semana" se cortan aquí.
APP_TIMEZONE=America/Bogota
# Moneda de los precios del catálogo (el seed viene en USD).
MONEDA=USD

# ---------------------------------------------------------------- Base de datos
# Base PROPIA de la app. Puede ser el mismo host que el Next, pero NUNCA su base.
# `npm run db:setup` la crea si no existe (el usuario necesita CREATEDB).
DATABASE_URL=postgresql://usuario:password@host:5432/iwantmyphone_app
DATABASE_SSL=false

# ---------------------------------------------------------------- Sesión (JWT HS256)
# Dos secretos distintos, mínimo 32 caracteres cada uno. Generar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Duraciones en segundos: 15 min el access, 30 días el refresh.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---------------------------------------------------------------- Correo (SMTP propio)
# Recuperación de contraseña. Sin SMTP_HOST el correo NO se envía: se escribe
# en la consola de la API (útil en desarrollo, nunca en producción).
SMTP_HOST=
# 465 = TLS implícito (SMTP_SECURE=true) · 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente. Debe ser un buzón que el servidor permita enviar (SPF/DKIM).
SMTP_FROM="iwantmyphone <no-reply@tu-dominio.com>"
# Solo para servidores con certificado autofirmado. En producción: true.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------- ePayco
# Panel de ePayco -> Integraciones -> Llaves API.
# P_CUST_ID_CLIENTE y P_KEY firman la confirmación: son SECRETOS.
# La PUBLIC_KEY es pública (la usa el checkout en el navegador).
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_P_KEY=
EPAYCO_PUBLIC_KEY=
# true = transacciones de prueba (tarjetas de test de ePayco).
EPAYCO_TEST=true
