                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.meta).to.have.property('totalPages');",
                  "});",
                  "if (res.data[0]) pm.environment.set('marca_id', res.data[0].id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/marcas?page=1&limit=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "marcas"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "12"
                }
