            "body": {
              "mode": "raw",
              "raw": "{\n  \"celular_id\": \"{{celular_nuevo_id}}\",\n  \"procesador\": \"Apple A19 Pro\",\n  \"ram\": \"12 GB\",\n  \"almacenamiento\": \"256GB / 512GB / 1TB\",\n  \"pantalla\": \"6.3\\\" ProMotion 120Hz\",\n  \"camara\": \"Triple 48 MP (Main, Ultra-Wide, Telephoto 5x)\",\n  \"bateria\": \"3800 mAh\",\n  \"sistema_op\": \"iOS 26.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
