                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca_id\": \"{{marca_nueva_id}}\",\n  \"modelo\": \"Postman Celular\",\n  \"precio\": 1000,\n  \"fecha_lanzamiento\": \"2026-09-23\",\n  \"images_url\": [\n    \"https://img.appledb.dev/device@256/iPhone17%2C1/Black.png\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/celulares",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "celulares"
              ]
            },
            "description": "`marca_id`* (UUID) · `modelo`* (hasta 150) · `precio`* (0 a 99 999 999,99, se redondea a 2 decimales) ·\n`fecha_lanzamiento`* (`AAAA-MM-DD` y fecha real: `2026-02-30` es 400) · `images_url` (hasta 20 URLs http(s)\nsin comas; `[]` o `null` guardan NULL).\n\nResponde con el shape del detalle: sin ficha y con `valoracion: 0`."
          },
          "response": []
        },
        {
          "name": "PATCH · Actualización parcial (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 · celular actualizado\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 2000,\n  \"images_url\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/celulares/{{celular_nuevo_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "celulares",
                "{{celular_nuevo_id}}"
              ]
            },
            "description": "`images_url: []` deja la columna en NULL, y el `GET` sigue devolviendo un array vacío (nunca `null`)."
          },
          "response": []
        },
        {
