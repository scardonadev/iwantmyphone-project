# Copiar a .env.local (ignorado por git) y ajustar.
DATABASE_URL=postgresql://postgres_user:postgres_pass@host:port/bd_name
DATABASE_SSL=false
# Firma de los JWT de sesión del backoffice (HS256). Mínimo 32 caracteres.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=secret_key
